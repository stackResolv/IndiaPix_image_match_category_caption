# Copy this file to ".env" and paste your real key.
# (The real .env is git-ignored and will NOT come with the clone.)
#
# categorize.py defaults to Anthropic Claude → set ANTHROPIC_API_KEY
# To use OpenAI instead: categorize.py --model gpt-4o-mini → set OPENAI_API_KEY

ANTHROPIC_API_KEY=
OPENAI_API_KEY=